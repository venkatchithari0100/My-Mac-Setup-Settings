# title: Developer apps & AI tools
cask "ghostty"                    # Fast native terminal (main)
cask "iterm2"                     # Feature-rich terminal (backup)
cask "claude-code"                # Claude Code AI coding agent
cask "visual-studio-code"         # VS Code editor
