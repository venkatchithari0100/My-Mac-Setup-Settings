cask "antigravity"                # Google Antigravity AI IDE
cask "docker-desktop"             # Docker containers
cask "postman"                    # API testing
cask "github"                     # GitHub Desktop
brew "node"                       # Node.js + npm
brew "python"                     # Python 3
brew "uv"                         # Fast Python package/venv manager
brew "go"                         # Go language
