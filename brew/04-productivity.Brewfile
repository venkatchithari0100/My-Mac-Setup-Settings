# title: Productivity (no ads)
cask "raycast"                    # Spotlight replacement, clipboard, snippets
cask "rectangle"                  # Window snapping with shortcuts
cask "alt-tab"                    # Windows-style app switcher with previews
cask "maccy"                      # Clipboard history
cask "stats"                      # CPU/RAM/network in the menu bar
cask "jordanbaird-ice"            # Hide menu bar icons (Ice)
cask "obsidian"                   # Markdown notes
cask "notion"                     # Notion workspace
cask "bitwarden"                  # Open-source password manager
