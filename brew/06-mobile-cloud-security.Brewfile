# title: Mobile, cloud & security dev tools
cask "temurin@25"                 # Java 25 LTS JDK (same as Android Studio; for Android builds)
cask "android-studio"             # Android IDE (Kotlin + Jetpack Compose)
cask "android-commandlinetools"   # sdkmanager/avdmanager for the Android SDK step
brew "hashicorp/tap/terraform"    # Infrastructure as code (AWS)
brew "pnpm"                       # Fast Node.js package manager
brew "gitleaks"                   # Finds secrets committed to git
brew "trivy"                      # Scans containers & dependencies for vulnerabilities
