# title: Core CLI tools & shell (recommended on every Mac)
brew "git"                        # Latest git (newer than Apple's)
brew "gh"                         # GitHub CLI
brew "gnupg"                      # GPG for signed commits
brew "pinentry-mac"               # macOS password prompt for GPG
brew "jq"                         # JSON processor (used by the Claude status line)
brew "starship"                   # Fast prompt theme
brew "zsh-autosuggestions"        # Suggests commands from history as you type
brew "zsh-syntax-highlighting"    # Colors valid/invalid commands while typing
brew "fzf"                        # Fuzzy finder (Ctrl+T files, Alt+C folders)
brew "atuin"                      # Searchable shell history (Ctrl+R)
brew "zoxide"                     # Smarter cd: `z proj`
brew "eza"                        # Modern ls with icons and git status
brew "bat"                        # cat with syntax highlighting
brew "ripgrep"                    # Very fast grep (rg)
brew "fd"                         # Friendly find
brew "tlrc"                       # tldr pages: short, practical command examples
brew "mas"                        # Mac App Store CLI (used by sync)
cask "font-jetbrains-mono-nerd-font" # Font with icons for the prompt
